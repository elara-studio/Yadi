{
  "name": "yadi",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter app tauri dev",
    "build": "pnpm --filter app tauri build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && cargo test --manifest-path app/src-tauri/Cargo.toml",
    "lint": "eslint . && prettier --check . && cargo fmt --manifest-path app/src-tauri/Cargo.toml --check && cargo clippy --manifest-path app/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path app/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "globals": "^16",
    "prettier": "^3",
    "typescript-eslint": "^8"
  }
}
