{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the mascot and chat windows",
  "windows": ["mascot", "chat"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:11434/*"
        }
      ]
    }
  ]
}
